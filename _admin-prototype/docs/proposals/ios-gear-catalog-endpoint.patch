+//
+//  GearCatalogEndpointTests.swift
+//  EightyFiveBlendsTests
+//
+//  The move from the Storage objects to the read-only gear-catalog endpoint (backend decision D10):
+//  URL construction for both sources, a catalog accepted from the old path surviving the update,
+//  the endpoint's SHA-256 ETags (strong and gateway-weakened) with 304, delayed older responses,
+//  and 404/503 never clearing what the app shows. Runs the real GearCatalogStore with an injected
+//  fetch and a private UserDefaults suite; no network.
+//
+
+import Foundation
+import Testing
+@testable import EightyFiveBlends
+
+@MainActor
+struct GearCatalogEndpointTests {
+
+    // MARK: - Fixtures
+
+    private nonisolated static let project = URL(string: "https://example.supabase.co/rest/v1/")!
+    private nonisolated static let oldStorageURL = URL(string: "https://example.supabase.co/storage/v1/object/public/recommended-gear/catalog-v1.json")!
+    private nonisolated static let endpointURL = URL(string: "https://example.supabase.co/functions/v1/gear-catalog/production")!
+
+    private static func document(revision: String, publishedAt: Double, name: String = "Endpoint Brand") -> Data {
+        let brand: [String: Any] = [
+            "id": "endpoint-brand", "kind": "brand", "name": name, "tagline": "Tools",
+            "description": "Product details", "ctaTitle": "View products", "destinationURL": "https://example.com/products",
+        ]
+        let object: [String: Any] = ["schemaVersion": 1, "revision": revision, "publishedAt": publishedAt, "brands": [brand]]
+        return try! JSONSerialization.data(withJSONObject: object, options: [.sortedKeys])
+    }
+
+    /// Records requests and returns queued replies.
+    private final class Server {
+        var replies: [(status: Int, body: Data, headers: [String: String])] = []
+        var requests: [URLRequest] = []
+
+        func fetch(_ request: URLRequest) async throws -> (Data, URLResponse) {
+            requests.append(request)
+            guard !replies.isEmpty else { throw URLError(.notConnectedToInternet) }
+            let reply = replies.removeFirst()
+            return (reply.body, HTTPURLResponse(url: request.url!, statusCode: reply.status, httpVersion: "HTTP/1.1", headerFields: reply.headers)!)
+        }
+    }
+
+    private struct Harness {
+        let suite = "GearCatalogEndpointTests.\(UUID().uuidString)"
+        let defaults: UserDefaults
+        let server = Server()
+
+        init() throws { defaults = try #require(UserDefaults(suiteName: suite)) }
+
+        @MainActor
+        func makeStore(_ endpoint: URL) -> GearCatalogStore {
+            let server = self.server
+            return GearCatalogStore(defaults: defaults, endpoints: [.production: endpoint],
+                                    fetch: { try await server.fetch($0) },
+                                    now: { Date(timeIntervalSince1970: 1_800_000_000) },
+                                    sleep: { _ in throw CancellationError() },
+                                    observesApplication: false)
+        }
+
+        func tearDown() { defaults.removePersistentDomain(forName: suite) }
+    }
+
+    private static func ifNoneMatch(_ server: Server) -> String? {
+        server.requests.last?.value(forHTTPHeaderField: "If-None-Match")
+    }
+
+    // MARK: - URL construction
+
+    @Test(arguments: [
+        "https://example.supabase.co/rest/v1/",
+        "https://example.supabase.co/rest/v1",
+        "https://example.supabase.co/",
+        "https://example.supabase.co"
+    ])
+    func bothSourcesUseTheGearCatalogEndpoint(configured: String) throws {
+        let base = try #require(URL(string: configured))
+        #expect(GearCatalogStore.storageObjectURL(from: base, objectPath: GearCatalogSource.production.objectPath).absoluteString
+                == "https://example.supabase.co/functions/v1/gear-catalog/production")
+        #expect(GearCatalogStore.storageObjectURL(from: base, objectPath: GearCatalogSource.staging.objectPath).absoluteString
+                == "https://example.supabase.co/functions/v1/gear-catalog/staging")
+    }
+
+    @Test func noSourceStillPointsAtTheOldStorageObjects() {
+        for source in GearCatalogSource.allCases {
+            #expect(!source.objectPath.contains("storage/v1"))
+            #expect(!source.objectPath.contains("catalog-v1.json"))
+        }
+    }
+
+    // MARK: - Retained cache across the update
+
+    @Test func aCatalogAcceptedFromTheOldPathIsKeptAndRevalidatedAgainstTheEndpoint() async throws {
+        let harness = try Harness()
+        defer { harness.tearDown() }
+        let r1 = Self.document(revision: "r1", publishedAt: 1_800_000_000)
+
+        // Before the update: accepted from the Storage object, with Storage's ETag.
+        let before = harness.makeStore(Self.oldStorageURL)
+        harness.server.replies = [(200, r1, ["ETag": "\"storage-etag\""])]
+        #expect(await before.refresh(force: true) == .updated)
+
+        // After the update (same UserDefaults): shown immediately from the saved copy, before any request.
+        let after = harness.makeStore(Self.endpointURL)
+        #expect(after.source == .published)
+        #expect(after.catalog?.revision == "r1")
+
+        // First request to the endpoint sends the old ETag; the endpoint answers 200 with the same
+        // bytes and its own SHA-256 ETag: nothing visible changes, and the new ETag is kept.
+        harness.server.replies = [(200, r1, ["ETag": "\"5a1b-sha256\""]), (304, Data(), [:])]
+        let generation = after.generation
+        #expect(await after.refresh(force: true) == .unchanged)
+        #expect(harness.server.requests.last?.url == Self.endpointURL)
+        #expect(Self.ifNoneMatch(harness.server) == "\"storage-etag\"")
+        #expect(after.generation == generation)
+        #expect(await after.refresh(force: true) == .notModified)
+        #expect(Self.ifNoneMatch(harness.server) == "\"5a1b-sha256\"")
+        #expect(after.catalog?.revision == "r1")
+    }
+
+    @Test func orderingStateSurvivesTheUpdate() async throws {
+        let harness = try Harness()
+        defer { harness.tearDown() }
+        let before = harness.makeStore(Self.oldStorageURL)
+        harness.server.replies = [(200, Self.document(revision: "r2", publishedAt: 1_800_000_200), [:])]
+        #expect(await before.refresh(force: true) == .updated)
+
+        // The endpoint (or a cache in front of it) serves something older than what was accepted.
+        let after = harness.makeStore(Self.endpointURL)
+        harness.server.replies = [(200, Self.document(revision: "r1", publishedAt: 1_800_000_100), ["ETag": "\"old\""])]
+        #expect(await after.refresh(force: true) == .rejected(.stale))
+        #expect(after.catalog?.revision == "r2")
+    }
+
+    // MARK: - ETags and 304
+
+    @Test func aGatewayWeakenedETagIsSentBackAsReceivedAnd304KeepsContent() async throws {
+        let harness = try Harness()
+        defer { harness.tearDown() }
+        let store = harness.makeStore(Self.endpointURL)
+        harness.server.replies = [(200, Self.document(revision: "r1", publishedAt: 1_800_000_000), ["ETag": "W/\"abc123\""]),
+                                  (304, Data(), ["ETag": "W/\"abc123\""])]
+        #expect(await store.refresh(force: true) == .updated)
+        #expect(harness.server.requests.first?.value(forHTTPHeaderField: "If-None-Match") == nil)
+        #expect(await store.refresh(force: true) == .notModified)
+        #expect(Self.ifNoneMatch(harness.server) == "W/\"abc123\"")
+        #expect(store.catalog?.revision == "r1")
+    }
+
+    @Test func requestsCarryNoCredentials() async throws {
+        let harness = try Harness()
+        defer { harness.tearDown() }
+        let store = harness.makeStore(Self.endpointURL)
+        harness.server.replies = [(200, Self.document(revision: "r1", publishedAt: 1_800_000_000), [:])]
+        _ = await store.refresh(force: true)
+        let request = try #require(harness.server.requests.last)
+        #expect(request.value(forHTTPHeaderField: "Authorization") == nil)
+        #expect(request.value(forHTTPHeaderField: "apikey") == nil)
+        #expect(request.value(forHTTPHeaderField: "Accept") == "application/json")
+    }
+
+    // MARK: - Delayed responses
+
+    @Test func aDelayedOlderPublicationNeverReplacesANewerOne() async throws {
+        let harness = try Harness()
+        defer { harness.tearDown() }
+        let store = harness.makeStore(Self.endpointURL)
+        let v1 = Self.document(revision: "v1", publishedAt: 1_800_000_100, name: "First")
+        let v2 = Self.document(revision: "v2", publishedAt: 1_800_000_200, name: "Second")
+        let rollback = Self.document(revision: "v3", publishedAt: 1_800_000_300, name: "First")
+        harness.server.replies = [(200, v2, ["ETag": "\"v2\""]), (200, v1, ["ETag": "\"v1\""]), (200, rollback, ["ETag": "\"v3\""])]
+        #expect(await store.refresh(force: true) == .updated)
+        #expect(await store.refresh(force: true) == .rejected(.stale))   // v1 arrives late (a cache, a slow edge)
+        #expect(store.catalog?.revision == "v2")
+        #expect(await store.refresh(force: true) == .updated)           // a rollback is a new, newer publication
+        #expect(Self.ifNoneMatch(harness.server) == "\"v2\"")          // the rejected v1 response did not replace the ETag
+        #expect(store.catalog?.revision == "v3")
+    }
+
+    // MARK: - 404 and 503
+
+    @Test func notPublishedAndServerErrorsNeverClearAPublishedCatalog() async throws {
+        let harness = try Harness()
+        defer { harness.tearDown() }
+        let store = harness.makeStore(Self.endpointURL)
+        harness.server.replies = [(200, Self.document(revision: "r1", publishedAt: 1_800_000_000), ["ETag": "\"r1\""]),
+                                  (404, Data("{\"error\":\"not_published\"}".utf8), [:]),
+                                  (503, Data("{\"error\":\"unavailable\"}".utf8), ["Cache-Control": "no-store"])]
+        #expect(await store.refresh(force: true) == .updated)
+        #expect(await store.refresh(force: true) == .httpStatus(404))
+        #expect(await store.refresh(force: true) == .httpStatus(503))
+        #expect(store.source == .published)
+        #expect(store.catalog?.revision == "r1")
+        // Still kept after a relaunch.
+        let relaunched = harness.makeStore(Self.endpointURL)
+        #expect(relaunched.catalog?.revision == "r1")
+    }
+
+    @Test func beforeTheFirstPublicationProductionKeepsBundledContent() async throws {
+        let harness = try Harness()
+        defer { harness.tearDown() }
+        let store = harness.makeStore(Self.endpointURL)
+        let bundled = store.content.pages.map(\.id)
+        harness.server.replies = [(404, Data("{\"error\":\"not_published\"}".utf8), [:]), (503, Data(), [:])]
+        #expect(await store.refresh(force: true) == .httpStatus(404))
+        #expect(await store.refresh(force: true) == .httpStatus(503))
+        #expect(store.source == .bundled)
+        #expect(store.content.pages.map(\.id) == bundled)
+    }
+}
